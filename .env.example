# Arduino Workflow Builder — Environment Variables
# SvelteKit: PUBLIC_ prefix = exposed to client. Everything else is server-only.
# Copy to .env.local and fill in. Keys marked [prod] are required only in production.
# All values below are FAKE examples — replace every one of them.

# ── Core (required) ──────────────────────────────────────────────
# Neon Postgres
DATABASE_URL=postgresql://neondb_owner:super-secret-password@ep-frosty-breeze-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
BETTER_AUTH_URL=http://localhost:5173

# Resend (transactional email / verification)
RESEND_API_KEY=re_Ex4mP1eEx4mP1eEx4mP1eEx4mP1eEx4mP1

# ── OAuth ────────────────────────────────────────────────────────
# GitHub app: https://github.com/settings/apps — callback <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=Ov23liEx4mP1eC11eNt1d
GITHUB_CLIENT_SECRET=5ecr3t5ecr3t5ecr3t5ecr3t5ecr3t
# Google credentials: https://console.cloud.google.com/apis/credentials — redirect <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=123456789012-abcd1234exampleappsusercontentexample.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=G0CSPX-Ex4mP1e5ecr3t

# Local/off-Pages only. In production the bucket is bound via wrangler.toml [[r2_buckets]].
R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
R2_ACCESS_KEY=Ex4mP1eAcc3sK3y
R2_SECRET_KEY=Ex4mP1eS3cr3tK3y
R2_BUCKET=your-bucket-name

# Same DSN for client + server init (was hardcoded). From Sentry → Project Settings → Client Keys.
PUBLIC_SENTRY_DSN=https://a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6@o123456.ingest.sentry.io/4500000000000000
# Build-time sourcemap upload (CI secret; local builds skip upload when absent)
SENTRY_AUTH_TOKEN=sntrys_Ex4mP1eT0k3nEx4mP1eT0k3n
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

NEON_API_KEY=napi_Ex4mP1eNe0nA9iK3y
NEON_PROJECT_ID=empty-fire-12345678

# HTTP source token from Better Stack → Sources. Absent = server logger no-ops.
BETTER_STACK_SOURCE_TOKEN=Ex4mP1eS0urceT0k3n

# Required in production (validateEnv fails closed); absent in dev = rate limiting disabled.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AZf1Ex4mP1eT0k3n

K6_TEST_EMAIL=k6@example.com
K6_TEST_PASSWORD=k6-test-password-123

# ── Misc ─────────────────────────────────────────────────────────
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173
