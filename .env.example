# Arduino Workflow Builder Environment Variables
# SvelteKit requires PUBLIC_ prefix for client-side variables

# Neon Postgres (Database)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Also accepts Better Auth API key (ba_...) as fallback
# BETTER_AUTH_API_KEY=ba_your-api-key-here

# OAuth providers (optional — set to empty to skip)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 — env vars only needed when running locally or outside Cloudflare Pages.
# In production, the bucket is bound via wrangler.toml [[r2_buckets]] binding.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=arduino-workflow-files

# Development Settings
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173