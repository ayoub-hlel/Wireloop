{
  "private": true,
  "name": "wireloop",
  "description": "Wireloop - Visual programming for Arduino development and electronics education",
  "version": "3.0.0",
  "scripts": {
    "dev": "cp env/env.development.ts src/env.ts && vite dev",
    "build": "cp ./env/env.staging.ts ./src/env.ts && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test-coverage": "vitest --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.7.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@sveltestrap/sveltestrap": "^6.2.7",
    "@svgdotjs/svg.draggable.js": "^3.0.2",
    "@svgdotjs/svg.js": "^3.0.16",
    "@svgdotjs/svg.panzoom.js": "^2.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/dotenv": "^8.2.0",
    "@types/file-saver": "^2.0.1",
    "@types/jest": "^25.2.3",
    "@types/lodash": "^4.14.157",
    "@vitest/coverage-istanbul": "^1.5.3",
    "@vitest/coverage-v8": "^1.5.3",
    "bits-ui": "^2.17.2",
    "blockly": "^10.4.3",
    "blockly-field-color-wheel": "^1.0.5",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.9.0",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "mode-watcher": "^1.1.0",
    "rollup-plugin-copy": "^3.3.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.1",
    "svelte-check": "^3.6.0",
    "svelte-sonner": "^1.1.0",
    "sweetalert": "^2.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.1.2",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "uuid": "^8.3.1",
    "vite": "^6.4.2",
    "vitest": "^1.5.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.20",
    "codemirror": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2"
  }
}
