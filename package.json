{
  "private": true,
  "name": "wireloop",
  "description": "Wireloop - Visual programming for Arduino development and electronics education",
  "version": "3.0.0",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "cp env/env.development.ts src/config.ts && vite dev",
    "build": "cp ./env/env.staging.ts ./src/config.ts && vite build",
    "build:prod": "cp ./env/env.prod.ts ./src/config.ts && vite build",
    "preview": "vite preview",
    "test": "svelte-kit sync && vitest",
    "test-coverage": "vitest --coverage",
    "check": "cp -n env/env.development.ts src/config.ts; svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "wrangler pages deploy",
    "deploy:prod": "pnpm db:migrate && pnpm build:prod && wrangler pages deploy --branch main",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:load": "k6 run k6/smoke.js",
    "test:load:full": "k6 run k6/load.js",
    "test:load:mutations": "k6 run k6/mutations.js",
    "test:load:uploads": "k6 run k6/uploads.js",
    "test:load:stress": "k6 run k6/stress.js",
    "test:load:mixed": "k6 run k6/mixed.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@electric-sql/pglite": "^0.5.7",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@sveltestrap/sveltestrap": "^7.1.0",
    "@svgdotjs/svg.draggable.js": "^3.0.6",
    "@svgdotjs/svg.js": "^3.2.8",
    "@svgdotjs/svg.panzoom.js": "^2.1.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/file-saver": "^2.0.1",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^3.2.6",
    "bits-ui": "^2.17.2",
    "blockly": "^10.4.3",
    "blockly-field-color-wheel": "^1.0.5",
    "clsx": "^2.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "file-saver": "^2.0.5",
    "globals": "^17.11.0",
    "lodash": "^4.17.21",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "sweetalert": "^2.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "uuid": "^11.1.1",
    "vite": "^6.4.2",
    "vitest": "^3.2.6",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "svelte-preprocess",
      "workerd"
    ]
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/browser": "^10.70.0",
    "@sentry/sveltekit": "^10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.6.29",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "lodash-es": "^4.18.1",
    "resend": "^6.20.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
